# /opt/meu-funil/.env no EC2 — copie, chmod 600 e preencha. Gere cada segredo com: openssl rand -hex 32
# NODE_ENV, PORT, DATABASE_URL, UPLOADS_DIR, FFMPEG_PATH, TRUST_PROXY e SCHEDULER_ENABLED vêm do docker-compose.prod.yml.
POSTGRES_PASSWORD=
JWT_SECRET=
# Cofre (AES-256-GCM, chave derivada por HKDF). NUNCA troque depois de salvar credenciais: o que está no cofre fica ilegível.
CREDENTIALS_ENCRYPTION_KEY=
UNSUBSCRIBE_SECRET=
FILES_SIGNING_SECRET=
# Segredo do x-cron-secret de POST /api/public/cron/* (o agendador interno já roda os jobs; isto é só para chamada externa).
CRM_CRON_SECRET=

PUBLIC_URL=https://api-meufunil.freelaservicosapp.com.br
# URL de produção do web na Vercel (base dos links de descadastro, SQL, Canva). Sem barra no fim.
APP_URL=
# Origens do web (Vercel). Separadas por vírgula, sem barra no fim.
CORS_ORIGINS=

# IA — gateway compatível com OpenAI (era o Lovable AI gateway). Vazio = só as chaves BYO que cada empresa salva em Integrações.
# ⚠️ Com o gateway ligado, QUALQUER conta nova (cadastro é aberto) gasta deste saldo.
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=

# Integrações (todas opcionais; vazio = a tela mostra "não conectado")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
RESEND_API_KEY=
CALCOM_API_KEY=
WHATSAPP_WEBHOOK_SECRET=
