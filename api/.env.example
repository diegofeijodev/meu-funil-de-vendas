# --- Obrigatórias ---
DATABASE_URL=postgresql://meufunil:meufunil@localhost:5439/meufunil?schema=public
# 16+ caracteres. Em produção: segredo forte e único.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# --- Servidor ---
NODE_ENV=development
PORT=3015
CORS_ORIGINS=http://localhost:3025
# URL pública da API (links de arquivos assinados e callback do OAuth do Google)
PUBLIC_URL=http://localhost:3015
# URL do web (era https://www.meufunildevendas.com.br): descadastro, SQL, Canva, redirect do login
APP_URL=http://localhost:3025
# true atrás de nginx (confia em X-Forwarded-For)
TRUST_PROXY=false
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=30d

# --- Arquivos (bucket creative-assets/ig-media em disco) ---
UPLOADS_DIR=./uploads
# FILES_SIGNING_SECRET=   # opcional; sem ele deriva de JWT_SECRET

# --- Cofre de credenciais (AES-256-GCM). OBRIGATÓRIA em produção. ---
# CREDENTIALS_ENCRYPTION_KEY=

# --- IA: gateway compatível com OpenAI (base URL com /v1) + mapa de modelos ---
# AI_GATEWAY_URL=https://api.openai.com/v1
# AI_GATEWAY_API_KEY=
# AI_MODEL_TEXT=gpt-4o                 # openai/gpt-6-astra
# AI_MODEL_TEXT_FAST=gpt-4o-mini
# AI_MODEL_IMAGE_OPENAI=gpt-image-1    # openai/gpt-image-2.5-sunburst
# AI_MODEL_IMAGE_GEMINI=gemini-2.5-flash-image   # google/gemini-3.1-flash-image
# AI_MODEL_VIDEO=veo-3.0-fast-generate-preview   # google/veo-3.1-fast
# AI_MODEL_GEMINI_FLASH=gemini-2.5-flash         # google/gemini-3.1-flash
# AI_MODEL_GEMINI_PRO=gemini-2.5-pro             # google/gemini-3.1-pro
# AI_BYO_OPENAI_TEXT_MODEL=gpt-4o-mini
# AI_BYO_GEMINI_TEXT_MODEL=gemini-flash-latest

# --- Login com Google (opcional; sem isto /v1/auth/google responde 503) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Agendador (ligue em UMA instância só) ---
SCHEDULER_ENABLED=false

# --- Usadas por tarefas futuras (todas opcionais) ---
# CRM_CRON_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# META_SYSTEM_USER_TOKEN=
# META_GRAPH_TOKEN=
# META_AD_ACCOUNT_ID=
# META_PAGE_ID=
# META_INSTAGRAM_ACCOUNT_ID=
