generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum workspace_role {
  owner
  admin
  marketing
  viewer
}

model users {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String
  password_hash String?
  google_sub    String?
  token_version Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([email])
  @@unique([google_sub])
}

model profiles {
  id         String   @id @db.Uuid
  email      String?
  full_name  String?
  avatar_url String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model workspaces {
  id                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String
  slug                       String
  plan                       String                     @default("trial")
  owner_id                   String                     @db.Uuid
  created_at                 DateTime                   @default(now()) @db.Timestamptz(6)
  ai_inherit_from            String?                    @db.Uuid
  ai_inherit_source          workspaces?                @relation("workspaces_ai_inherit_from", fields: [ai_inherit_from], references: [id], onDelete: SetNull)
  workspaces_ai_inherit_from workspaces[]               @relation("workspaces_ai_inherit_from")
  workspace_members          workspace_members[]        @relation("workspace_members_workspace_id")
  brands                     brands[]                   @relation("brands_workspace_id")
  brand_assets               brand_assets[]             @relation("brand_assets_workspace_id")
  products                   products[]                 @relation("products_workspace_id")
  personas                   personas[]                 @relation("personas_workspace_id")
  brand_learnings            brand_learnings[]          @relation("brand_learnings_workspace_id")
  campaigns                  campaigns[]                @relation("campaigns_workspace_id")
  campaign_strategies        campaign_strategies[]      @relation("campaign_strategies_workspace_id")
  copies                     copies[]                   @relation("copies_workspace_id")
  creatives                  creatives[]                @relation("creatives_workspace_id")
  creative_versions          creative_versions[]        @relation("creative_versions_workspace_id")
  creative_generation_jobs   creative_generation_jobs[] @relation("creative_generation_jobs_workspace_id")
  approval_requests          approval_requests[]        @relation("approval_requests_workspace_id")
  activity_logs              activity_logs[]            @relation("activity_logs_workspace_id")
  ai_recommendations         ai_recommendations[]       @relation("ai_recommendations_workspace_id")
  social_posts               social_posts[]             @relation("social_posts_workspace_id")
  publishing_jobs            publishing_jobs[]          @relation("publishing_jobs_workspace_id")
  instagram_accounts         instagram_accounts?        @relation("instagram_accounts_workspace_id")
  ig_content_plans           ig_content_plans[]         @relation("ig_content_plans_workspace_id")
  ig_posts                   ig_posts[]                 @relation("ig_posts_workspace_id")
  ig_post_metrics            ig_post_metrics[]          @relation("ig_post_metrics_workspace_id")
  ig_autopilot_events        ig_autopilot_events[]      @relation("ig_autopilot_events_workspace_id")
  ig_account_insights        ig_account_insights[]      @relation("ig_account_insights_workspace_id")
  ig_auto_runs               ig_auto_runs[]             @relation("ig_auto_runs_workspace_id")
  meta_accounts              meta_accounts[]            @relation("meta_accounts_workspace_id")
  meta_campaigns             meta_campaigns[]           @relation("meta_campaigns_workspace_id")
  meta_adsets                meta_adsets[]              @relation("meta_adsets_workspace_id")
  meta_ads                   meta_ads[]                 @relation("meta_ads_workspace_id")
  performance_daily          performance_daily[]        @relation("performance_daily_workspace_id")
  conversions                conversions[]              @relation("conversions_workspace_id")
  campaign_costs             campaign_costs[]           @relation("campaign_costs_workspace_id")
  media_assets               media_assets[]             @relation("media_assets_workspace_id")
  crm_pipelines              crm_pipelines[]            @relation("crm_pipelines_workspace_id")
  crm_stages                 crm_stages[]               @relation("crm_stages_workspace_id")
  crm_loss_reasons           crm_loss_reasons[]         @relation("crm_loss_reasons_workspace_id")
  crm_tags                   crm_tags[]                 @relation("crm_tags_workspace_id")
  crm_settings               crm_settings?              @relation("crm_settings_workspace_id")
  crm_leads                  crm_leads[]                @relation("crm_leads_workspace_id")
  crm_interactions           crm_interactions[]         @relation("crm_interactions_workspace_id")
  crm_tasks                  crm_tasks[]                @relation("crm_tasks_workspace_id")
  crm_stage_history          crm_stage_history[]        @relation("crm_stage_history_workspace_id")
  crm_integrations           crm_integrations[]         @relation("crm_integrations_workspace_id")
  crm_cadences               crm_cadences[]             @relation("crm_cadences_workspace_id")
  crm_cadence_runs           crm_cadence_runs[]         @relation("crm_cadence_runs_workspace_id")
  crm_cadence_events         crm_cadence_events[]       @relation("crm_cadence_events_workspace_id")
  crm_conversations          crm_conversations[]        @relation("crm_conversations_workspace_id")
  crm_messages               crm_messages[]             @relation("crm_messages_workspace_id")
  crm_quick_replies          crm_quick_replies[]        @relation("crm_quick_replies_workspace_id")
  crm_wa_templates           crm_wa_templates[]         @relation("crm_wa_templates_workspace_id")
  crm_campaign_costs         crm_campaign_costs[]       @relation("crm_campaign_costs_workspace_id")
  crm_webhook_events         crm_webhook_events[]       @relation("crm_webhook_events_workspace_id")
  crm_sdr_agents             crm_sdr_agents?            @relation("crm_sdr_agents_workspace_id")
  crm_sdr_documents          crm_sdr_documents[]        @relation("crm_sdr_documents_workspace_id")
  crm_sdr_runs               crm_sdr_runs[]             @relation("crm_sdr_runs_workspace_id")
  integration_connections    integration_connections[]  @relation("integration_connections_workspace_id")
  mcp_connections            mcp_connections[]          @relation("mcp_connections_workspace_id")
  app_credentials            app_credentials[]          @relation("app_credentials_workspace_id")
}

model workspace_members {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String         @db.Uuid
  user_id      String         @db.Uuid
  role         workspace_role @default(marketing)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  workspace    workspaces     @relation("workspace_members_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, user_id])
  @@index([user_id], map: "workspace_members_user_idx")
}

model brands {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id             String                     @db.Uuid
  name                     String
  description              String?
  website                  String?
  segment                  String?
  differentials            String?
  target_audience          String?
  competitors              String?
  tone_of_voice            String?
  preferred_words          String[]                   @default([])
  banned_words             String[]                   @default([])
  primary_color            String?                    @default("#4F46E5")
  secondary_color          String?                    @default("#0EA5E9")
  typography               String?
  logo_url                 String?
  region                   String?
  past_campaigns           String?
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)
  visual_style             Json                       @default("{}") @db.JsonB
  workspace                workspaces                 @relation("brands_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)
  brand_assets             brand_assets[]             @relation("brand_assets_brand_id")
  products                 products[]                 @relation("products_brand_id")
  personas                 personas[]                 @relation("personas_brand_id")
  brand_learnings          brand_learnings[]          @relation("brand_learnings_brand_id")
  campaigns                campaigns[]                @relation("campaigns_brand_id")
  creatives                creatives[]                @relation("creatives_brand_id")
  creative_generation_jobs creative_generation_jobs[] @relation("creative_generation_jobs_brand_id")
  social_posts             social_posts[]             @relation("social_posts_brand_id")
  ig_content_plans         ig_content_plans[]         @relation("ig_content_plans_brand_id")
  media_assets             media_assets[]             @relation("media_assets_brand_id")

  @@index([workspace_id])
}

model brand_assets {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String     @db.Uuid
  brand_id     String     @db.Uuid
  kind         String     @default("photo")
  name         String?
  url          String?
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  tag          String?
  storage_path String?
  workspace    workspaces @relation("brand_assets_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)
  brand        brands     @relation("brand_assets_brand_id", fields: [brand_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
}

model products {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id   String     @db.Uuid
  brand_id       String     @db.Uuid
  name           String
  description    String?
  price          Decimal?   @db.Decimal
  margin_percent Decimal?   @db.Decimal
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  workspace      workspaces @relation("products_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)
  brand          brands     @relation("products_brand_id", fields: [brand_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
}

model personas {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String     @db.Uuid
  brand_id     String     @db.Uuid
  name         String
  age_range    String?
  location     String?
  interests    String?
  pains        String?
  desires      String?
  segment_type String?    @default("B2C")
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  workspace    workspaces @relation("personas_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)
  brand        brands     @relation("personas_brand_id", fields: [brand_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
}

model brand_learnings {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String     @db.Uuid
  brand_id     String     @db.Uuid
  category     String
  value        String
  metric       String?
  score        Decimal?   @default(0) @db.Decimal
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  workspace    workspaces @relation("brand_learnings_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)
  brand        brands     @relation("brand_learnings_brand_id", fields: [brand_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
}

model campaigns {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id             String                     @db.Uuid
  brand_id                 String                     @db.Uuid
  name                     String
  objective                String                     @default("leads")
  status                   String                     @default("draft")
  offer_product            String?
  offer_promise            String?
  landing_url              String?
  offer_price              Decimal?                   @db.Decimal
  start_date               DateTime?                  @db.Date
  end_date                 DateTime?                  @db.Date
  audience                 Json                       @default("{}") @db.JsonB
  budget_total             Decimal?                   @default(0) @db.Decimal
  budget_daily             Decimal?                   @default(0) @db.Decimal
  goal_leads               Decimal?                   @db.Decimal
  goal_sales               Decimal?                   @db.Decimal
  avg_ticket               Decimal?                   @db.Decimal
  margin_percent           Decimal?                   @db.Decimal
  max_cac                  Decimal?                   @db.Decimal
  formats                  String[]                   @default([])
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)
  meta_campaign_id         String?
  meta_adset_id            String?
  meta_ad_ids              String[]                   @default([])
  meta_delivery_status     String?
  meta_adset_ids           String[]                   @default([])
  meta_ad_map              Json                       @default("{}") @db.JsonB
  meta_lead_form_id        String?
  ads_config               Json                       @default("{}") @db.JsonB
  automation_rules         Json                       @default("{}") @db.JsonB
  last_insights_sync_at    DateTime?                  @db.Timestamptz(6)
  google_campaign_id       String?
  google_status            String?
  tiktok_campaign_id       String?
  tiktok_status            String?
  workspace                workspaces                 @relation("campaigns_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)
  brand                    brands                     @relation("campaigns_brand_id", fields: [brand_id], references: [id], onDelete: Cascade)
  campaign_strategies      campaign_strategies[]      @relation("campaign_strategies_campaign_id")
  copies                   copies[]                   @relation("copies_campaign_id")
  creatives                creatives[]                @relation("creatives_campaign_id")
  creative_generation_jobs creative_generation_jobs[] @relation("creative_generation_jobs_campaign_id")
  approval_requests        approval_requests[]        @relation("approval_requests_campaign_id")
  ai_recommendations       ai_recommendations[]       @relation("ai_recommendations_campaign_id")
  social_posts             social_posts[]             @relation("social_posts_campaign_id")
  publishing_jobs          publishing_jobs[]          @relation("publishing_jobs_campaign_id")
  ig_auto_runs             ig_auto_runs[]             @relation("ig_auto_runs_campaign_id")
  meta_campaigns           meta_campaigns[]           @relation("meta_campaigns_campaign_id")
  performance_daily        performance_daily[]        @relation("performance_daily_campaign_id")
  conversions              conversions[]              @relation("conversions_campaign_id")
  campaign_costs           campaign_costs[]           @relation("campaign_costs_campaign_id")
  media_assets             media_assets[]             @relation("media_assets_campaign_id")

  @@index([workspace_id])
  @@index([brand_id])
}

model campaign_strategies {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String     @db.Uuid
  campaign_id  String     @db.Uuid
  version      Int        @default(1)
  status       String     @default("draft")
  content      Json       @default("{}") @db.JsonB
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  workspace    workspaces @relation("campaign_strategies_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)
  campaign     campaigns  @relation("campaign_strategies_campaign_id", fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
}

model copies {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String     @db.Uuid
  campaign_id  String     @db.Uuid
  version      Int        @default(1)
  status       String     @default("draft")
  content      Json       @default("{}") @db.JsonB
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  angle        String?
  workspace    workspaces @relation("copies_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)
  campaign     campaigns  @relation("copies_campaign_id", fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
}

model creatives {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id             String                     @db.Uuid
  campaign_id              String?                    @db.Uuid
  brand_id                 String?                    @db.Uuid
  title                    String
  type                     String                     @default("static_image")
  prompt                   String?
  aspect_ratio             String?                    @default("1:1")
  copy_text                String?
  status                   String                     @default("draft")
  version                  Int                        @default(1)
  provider                 String                     @default("mock")
  estimated_cost           Decimal?                   @default(0) @db.Decimal
  real_cost                Decimal?                   @default(0) @db.Decimal
  preview_url              String?
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)
  final_prompt             String?
  error_message            String?
  thumbnail_url            String?
  external_job_id          String?
  angle                    String?
  extras                   Json                       @default("{}") @db.JsonB
  workspace                workspaces                 @relation("creatives_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)
  campaign                 campaigns?                 @relation("creatives_campaign_id", fields: [campaign_id], references: [id], onDelete: Cascade)
  brand                    brands?                    @relation("creatives_brand_id", fields: [brand_id], references: [id], onDelete: Cascade)
  creative_versions        creative_versions[]        @relation("creative_versions_creative_id")
  creative_generation_jobs creative_generation_jobs[] @relation("creative_generation_jobs_creative_id")
  social_posts             social_posts[]             @relation("social_posts_creative_id")
  meta_ads                 meta_ads[]                 @relation("meta_ads_creative_id")
  performance_daily        performance_daily[]        @relation("performance_daily_creative_id")
  media_assets             media_assets[]             @relation("media_assets_creative_id")

  @@index([workspace_id])
  @@index([campaign_id, angle], map: "creatives_campaign_angle")
}

model creative_versions {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String     @db.Uuid
  creative_id  String     @db.Uuid
  version      Int        @default(1)
  prompt       String?
  preview_url  String?
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  workspace    workspaces @relation("creative_versions_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)
  creative     creatives  @relation("creative_versions_creative_id", fields: [creative_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
}

model creative_generation_jobs {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id    String     @db.Uuid
  brand_id        String?    @db.Uuid
  campaign_id     String?    @db.Uuid
  creative_id     String?    @db.Uuid
  provider        String     @default("mock")
  type            String     @default("static_image")
  prompt          String?
  final_prompt    String?
  aspect_ratio    String?
  status          String     @default("queued")
  external_job_id String?
  asset_url       String?
  thumbnail_url   String?
  error_message   String?
  estimated_cost  Decimal?   @default(0) @db.Decimal
  actual_cost     Decimal?   @default(0) @db.Decimal
  created_by      String?    @db.Uuid
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  completed_at    DateTime?  @db.Timestamptz(6)
  provider_log    String?
  options         Json       @default("{}") @db.JsonB
  workspace       workspaces @relation("creative_generation_jobs_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)
  brand           brands?    @relation("creative_generation_jobs_brand_id", fields: [brand_id], references: [id], onDelete: SetNull)
  campaign        campaigns? @relation("creative_generation_jobs_campaign_id", fields: [campaign_id], references: [id], onDelete: SetNull)
  creative        creatives? @relation("creative_generation_jobs_creative_id", fields: [creative_id], references: [id], onDelete: SetNull)

  @@index([workspace_id, created_at(sort: Desc)], map: "creative_generation_jobs_ws_idx")
}

model approval_requests {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String     @db.Uuid
  entity_type  String
  entity_id    String?    @db.Uuid
  campaign_id  String?    @db.Uuid
  title        String
  summary      String?
  status       String     @default("pending")
  requested_by String?    @db.Uuid
  decided_by   String?    @db.Uuid
  decided_at   DateTime?  @db.Timestamptz(6)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  workspace    workspaces @relation("approval_requests_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)
  campaign     campaigns? @relation("approval_requests_campaign_id", fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
}

model activity_logs {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String     @db.Uuid
  actor_id     String?    @db.Uuid
  action       String
  entity_type  String?
  entity_id    String?    @db.Uuid
  metadata     Json       @default("{}") @db.JsonB
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  workspace    workspaces @relation("activity_logs_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
}

model ai_recommendations {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id      String     @db.Uuid
  campaign_id       String?    @db.Uuid
  action            String
  title             String
  reason            String
  estimated_impact  String?
  severity          String     @default("medium")
  requires_approval Boolean    @default(true)
  status            String     @default("pending")
  created_at        DateTime   @default(now()) @db.Timestamptz(6)
  payload           Json       @default("{}") @db.JsonB
  source            String     @default("ai")
  applied_at        DateTime?  @db.Timestamptz(6)
  applied_by        String?    @db.Uuid
  result            String?
  workspace         workspaces @relation("ai_recommendations_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)
  campaign          campaigns? @relation("ai_recommendations_campaign_id", fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
}

model social_posts {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id    String            @db.Uuid
  brand_id        String?           @db.Uuid
  campaign_id     String?           @db.Uuid
  channel         String            @default("instagram_feed")
  title           String
  copy_text       String?
  creative_id     String?           @db.Uuid
  status          String            @default("idea")
  scheduled_at    DateTime?         @db.Timestamptz(6)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  workspace       workspaces        @relation("social_posts_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)
  brand           brands?           @relation("social_posts_brand_id", fields: [brand_id], references: [id], onDelete: Cascade)
  campaign        campaigns?        @relation("social_posts_campaign_id", fields: [campaign_id], references: [id], onDelete: SetNull)
  creative        creatives?        @relation("social_posts_creative_id", fields: [creative_id], references: [id], onDelete: SetNull)
  publishing_jobs publishing_jobs[] @relation("publishing_jobs_post_id")

  @@index([workspace_id])
}

model publishing_jobs {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String        @db.Uuid
  campaign_id  String?       @db.Uuid
  post_id      String?       @db.Uuid
  target       String        @default("meta")
  status       String        @default("queued")
  mode         String        @default("mock")
  log          String?
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  channel      String        @default("meta_ads")
  ig_post_id   String?       @db.Uuid
  run_at       DateTime?     @db.Timestamptz(6)
  attempts     Int           @default(0)
  locked_at    DateTime?     @db.Timestamptz(6)
  workspace    workspaces    @relation("publishing_jobs_workspace_id", fields: [workspace_id], references: [id], onDelete: Cascade)
  campaign     campaigns?    @relation("publishing_jobs_campaign_id", fields: [campaign_id], references: [id], onDelete: Cascade)
  post         social_posts? @relation("publishing_jobs_post_id", fields: [post_id], references: [id], onDelete: Cascade)
  ig_post      ig_posts?     @relation("publishing_jobs_ig_post_id", fields: [ig_post_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
